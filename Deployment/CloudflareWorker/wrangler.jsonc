{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surge-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-06-29",
  "workers_dev": true,
  "vars": {
    "GITHUB_OWNER": "YOUR_GITHUB_OWNER",
    "GITHUB_REPOSITORY": "YOUR_REPOSITORY",
    "GITHUB_BRANCH": "main",
    "GITHUB_DIRECTORY": "modules"
  }
}
